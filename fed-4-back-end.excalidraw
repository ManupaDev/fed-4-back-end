    {
      "id": "gp-dZ8u2bVMcmjenvrTH3",
      "type": "text",
      "x": 3965.652419672112,
      "y": 5230.757723203111,
      "width": 415.7998352050781,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
