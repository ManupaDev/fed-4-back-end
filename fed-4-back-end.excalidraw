      "isDeleted": false,
      "boundElements": [],
      "updated": 1757866990966,
      "link": null,
      "locked": false,
      "text": "Promise => A promise that it will give a result later",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Promise => A promise that it will give a result later",
